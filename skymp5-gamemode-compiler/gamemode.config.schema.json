{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skymp.io/schemas/gamemode.config.schema.json",
  "title": "SkyMP gamemode compiler configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["outfile", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "outfile": { "type": "string", "minLength": 1, "pattern": "\\.js$" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entry"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 }
        }
      }
    },
    "external": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:@[A-Za-z0-9][A-Za-z0-9._~-]*/)?[A-Za-z0-9][A-Za-z0-9._~-]*$"
      }
    }
  }
}
