{
  "internalApi": { "host": "127.0.0.1", "port": 3001 },
  "database": { "adapter": "sqlite", "path": "./data/backend.sqlite" },
  "server": {
    "internalTokenEnv": "SKYMP_BACKEND_TOKEN",
    "name": "My SkyMP Server",
    "description": "A managed SkyMP server",
    "region": "eu-central",
    "tags": [],
    "gamePort": 7777,
    "resourcesPort": 7778,
    "gamemode": "default",
    "dataDirectory": "./data",
    "plugins": [],
    "loadOrder": [],
    "maxPlayers": 100,
    "visibility": "private",
    "access": { "discordGuild": { "required": false } }
  },
  "supervisor": {
    "command": "node",
    "args": ["dist_back/skymp5-server.js"],
    "cwd": "..",
    "readyTimeoutMs": 60000,
    "shutdownTimeoutMs": 15000,
    "restart": {
      "enabled": true,
      "initialDelayMs": 1000,
      "maxDelayMs": 30000,
      "maxAttempts": 5,
      "windowMs": 300000
    }
  },
  "sessions": {
    "ttlSeconds": 43200,
    "clockSkewMs": 30000
  },
  "network": { "autoMapPorts": false },
  "modules": [
    {
      "id": "directory-connector",
      "enabled": true,
      "required": true,
      "config": {
        "url": "https://skyservers.online",
        "autoRegister": true,
        "heartbeatIntervalMs": 15000
      }
    }
  ]
}
