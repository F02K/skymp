{
  "publicApi": { "host": "0.0.0.0", "port": 3000 },
  "internalApi": { "host": "127.0.0.1", "port": 3001 },
  "database": { "adapter": "sqlite", "path": "./data/backend.sqlite" },
  "server": {
    "id": "local-server",
    "internalTokenEnv": "SKYMP_BACKEND_TOKEN",
    "name": "My SkyMP Server",
    "description": "A managed SkyMP server",
    "region": "eu-central",
    "tags": [],
    "publicBackendUrl": "http://localhost:3000",
    "gameAddress": "127.0.0.1:7777",
    "maxPlayers": 100,
    "visibility": "private",
    "access": { "discordGuild": { "required": false } }
  },
  "supervisor": {
    "command": "node",
    "args": ["dist_back/skymp5-server.js"],
    "cwd": "..",
    "readyTimeoutMs": 60000,
    "shutdownTimeoutMs": 15000,
    "restart": {
      "enabled": true,
      "initialDelayMs": 1000,
      "maxDelayMs": 30000,
      "maxAttempts": 5,
      "windowMs": 300000
    }
  },
  "sessions": {
    "ttlSeconds": 43200,
    "directoryPublicKey": "MCowBQYDK2VwAyEA2jcO6XMepYSleeMojjMAfRjX9Pof9pS+B3uh9+Z17kE=",
    "clockSkewMs": 30000
  },
  "modules": [
    {
      "id": "directory-connector",
      "enabled": false,
      "required": false,
      "config": {
        "url": "https://skyservers.online",
        "credentialEnv": "SKYMP_DIRECTORY_CREDENTIAL",
        "heartbeatIntervalMs": 15000
      }
    }
  ]
}
